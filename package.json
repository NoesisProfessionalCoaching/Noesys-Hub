{
  "name": "noesys-hub",
  "version": "1.0.0",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "prova-migrazione": "node --env-file=.env scripts/prova-migrazione.js",
    "prova-file": "for f in server/*.js; do node --check \"$f\" || exit 1; done; echo '✓ i file del server compilano tutti.'",
    "prova-js": "node scripts/prova-js-pagine.js",
    "prova-fiscale": "node scripts/prova-fiscale.js",
    "prova-proforma": "node scripts/prova-proforma.js",
    "prova": "npm run prova-file && npm run prova-js && npm run prova-fiscale && npm run prova-proforma && npm run prova-tranche && npm run prova-incassi && npm run prova-appuntamenti && npm run prova-migrazione",
    "prova-tranche": "node scripts/prova-tranche.js",
    "prova-incassi": "node scripts/prova-incassi.js",
    "prova-appuntamenti": "node --env-file=.env scripts/prova-appuntamenti.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^6.10.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.11.3",
    "uuid": "^9.0.0"
  }
}
